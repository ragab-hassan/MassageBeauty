@model LandingVm
@{ ViewData["Title"] = "الرئيسية"; }

<div class="hero mb-4">
  <h3 class="fw-bold mb-1">احجز جلسة المساج والجمال القريبة منك</h3>
  <p class="mb-3 opacity-75">تصفّح الخدمات والباقات والعروض، اختر الأخصائي والموعد، وأكّد حجزك عبر واتساب المركز.</p>
  <form method="get" class="row g-2 align-items-center" id="searchForm">
    <input type="hidden" name="lat" id="lat" value="@Context.Request.Query["lat"]" />
    <input type="hidden" name="lng" id="lng" value="@Context.Request.Query["lng"]" />
    <div class="col-md-4"><input name="q" value="@Model.Q" class="form-control" placeholder="ابحث عن خدمة أو مركز..." /></div>
    <div class="col-md-3">
      <select name="city" class="form-select">
        <option value="">كل المدن</option>
        @foreach (var c in Model.Cities) { <option value="@c" selected="@(c == Model.City)">@c</option> }
      </select>
    </div>
    <div class="col-md-2">
      <select name="kind" class="form-select">
        <option value="">الكل</option>
        <option value="2" selected="@(Model.Kind == 2)">عروض</option>
        <option value="1" selected="@(Model.Kind == 1)">باقات</option>
        <option value="0" selected="@(Model.Kind == 0)">خدمات</option>
      </select>
    </div>
    <div class="col-6 col-md-1 d-grid"><button class="btn btn-light">بحث</button></div>
    <div class="col-6 col-md-2 d-grid"><button type="button" class="btn btn-outline-light" id="nearBtn"><i class="bi bi-geo-alt"></i> قريب مني</button></div>
  </form>
  @if (Model.HasLocation) { <div class="small mt-2"><i class="bi bi-check-circle"></i> يتم ترتيب النتائج حسب القرب من موقعك</div> }
</div>

@if (Model.Centers.Any())
{
  <h5 class="text-brand fw-bold mb-3">@(Model.HasLocation ? "المراكز القريبة منك" : "المراكز")</h5>
  <div class="d-flex gap-3 overflow-auto pb-2 mb-4">
    @foreach (var c in Model.Centers)
    {
      <a asp-controller="Center" asp-action="Index" asp-route-id="@c.S.Id" class="text-decoration-none text-reset" style="min-width:230px">
        <div class="card emp-card p-3">
          <div class="d-flex align-items-center gap-3">
            @Html.Thumb(c.S.LogoUrl, "thumb-sm")
            <div class="text-start" style="text-align:right!important">
              <div class="fw-bold">@c.S.BusinessName</div>
              <div class="small text-muted"><i class="bi bi-geo-alt"></i> @(string.IsNullOrWhiteSpace(c.S.City) ? "-" : c.S.City)@(c.Km != null ? $" · {c.Km} كم" : "")</div>
            </div>
          </div>
        </div>
      </a>
    }
  </div>

  <h5 class="text-brand fw-bold mb-3">الخدمات والباقات والعروض</h5>
  <div class="row g-3">
    @foreach (var x in Model.Services)
    {
      <div class="col-6 col-md-4 col-lg-3">
        <a asp-controller="Center" asp-action="Index" asp-route-id="@x.Center.Id" asp-fragment="s@(x.Svc.Id)" class="text-decoration-none text-reset">
          <div class="card svc-card h-100">
            <span class="badge @(x.Svc.Kind == ServiceKind.Offer ? "bg-danger" : x.Svc.Kind == ServiceKind.Package ? "bg-warning text-dark" : "bg-secondary") kind-badge">@x.Svc.KindLabel</span>
            @Html.Thumb(x.Svc.ImageUrl)
            <div class="card-body p-3">
              <div class="fw-bold">@x.Svc.Name</div>
              <div class="small text-muted mb-1"><i class="bi bi-shop"></i> @x.Center.BusinessName@(x.Km != null ? $" · {x.Km} كم" : "")</div>
              <div class="small text-muted"><i class="bi bi-clock"></i> @x.Svc.DurationMinutes دقيقة</div>
              <div class="mt-1">
                <span class="price">@x.Svc.Price.ToString("0.##") ر.س</span>
                @if (x.Svc.OldPrice > x.Svc.Price) { <span class="old-price small me-1">@x.Svc.OldPrice.Value.ToString("0.##")</span> }
              </div>
            </div>
          </div>
        </a>
      </div>
    }
  </div>
  @if (!Model.Services.Any()) { <div class="text-center text-muted py-4">لا توجد خدمات مطابقة للبحث</div> }
}
else
{
  <div class="text-center text-muted py-5">لا توجد مراكز متاحة حاليًا@(string.IsNullOrWhiteSpace(Model.City) && string.IsNullOrWhiteSpace(Model.Q) ? "" : " بهذه الشروط").</div>
}

@section Scripts {
<script>
  document.getElementById('nearBtn').addEventListener('click', () => {
    if (!navigator.geolocation) { alert('المتصفح لا يدعم تحديد الموقع'); return; }
    navigator.geolocation.getCurrentPosition(p => {
      document.getElementById('lat').value = p.coords.latitude.toFixed(6);
      document.getElementById('lng').value = p.coords.longitude.toFixed(6);
      document.getElementById('searchForm').submit();
    }, () => alert('تعذّر تحديد موقعك، فعّل صلاحية الموقع أو اختر المدينة'));
  });
</script>
}

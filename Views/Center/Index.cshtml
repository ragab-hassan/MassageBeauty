@model Subscriber
@{
  ViewData["Title"] = Model.BusinessName;
  var live = Model.Services.Where(s => s.IsLive).OrderBy(s => s.SortOrder).ThenBy(s => s.Name).ToList();
  var groups = new[] { (ServiceKind.Offer, "العروض"), (ServiceKind.Package, "الباقات"), (ServiceKind.Service, "الخدمات") };
}
<div class="center-cover mb-n5">@if (!string.IsNullOrEmpty(Model.CoverUrl)) { <img src="@Model.CoverUrl" alt="" /> }</div>
<div class="d-flex align-items-end gap-3 px-3" style="margin-top:-50px">
  @Html.Thumb(Model.LogoUrl, "thumb-lg")
  <div class="pb-2">
    <h4 class="fw-bold mb-0">@Model.BusinessName</h4>
    <div class="small text-muted"><i class="bi bi-geo-alt"></i> @Model.City @Model.Address · <i class="bi bi-clock"></i> @($"{Model.OpenHour:00}:00") - @($"{Model.CloseHour:00}:00")</div>
  </div>
</div>
@if (!string.IsNullOrWhiteSpace(Model.Description)) { <p class="mt-3">@Model.Description</p> }
@if (Model.Latitude != null && Model.Longitude != null)
{
  <a class="btn btn-sm btn-outline-secondary mb-3" target="_blank" href="https://www.google.com/maps?q=@Model.Latitude.Value.ToString(System.Globalization.CultureInfo.InvariantCulture),@Model.Longitude.Value.ToString(System.Globalization.CultureInfo.InvariantCulture)"><i class="bi bi-map"></i> الموقع على الخريطة</a>
}

@foreach (var (kind, title) in groups)
{
  var items = live.Where(s => s.Kind == kind).ToList();
  if (!items.Any()) { continue; }
  <h5 class="text-brand fw-bold mt-4 mb-3">@title</h5>
  <div class="row g-3">
    @foreach (var s in items)
    {
      <div class="col-md-6 col-lg-4" id="s@(s.Id)">
        <div class="card svc-card h-100">
          @if (s.Kind == ServiceKind.Offer) { <span class="badge bg-danger kind-badge">عرض</span> }
          @Html.Thumb(s.ImageUrl)
          <div class="card-body">
            <h6 class="fw-bold">@s.Name</h6>
            <div class="small text-muted mb-2"><i class="bi bi-clock"></i> @s.DurationMinutes دقيقة
              @if (s.Kind == ServiceKind.Offer && s.OfferEnd != null) { <span class="text-danger"> · ينتهي @s.OfferEnd.Value.ToString("yyyy-MM-dd")</span> }
            </div>
            @if (!string.IsNullOrWhiteSpace(s.Benefits)) { <p class="small mb-1"><i class="bi bi-heart-pulse text-brand"></i> @s.Benefits</p> }
            @if (!string.IsNullOrWhiteSpace(s.Description)) { <p class="small text-muted mb-2">@s.Description</p> }
            <div>
              <span class="price">@s.Price.ToString("0.##") ر.س</span>
              @if (s.OldPrice > s.Price) { <span class="old-price small me-1">@s.OldPrice.Value.ToString("0.##")</span> }
            </div>
          </div>
          <div class="card-footer bg-transparent border-0">
            <a asp-action="Employees" asp-route-serviceId="@s.Id" class="btn btn-brand w-100">احجز الآن</a>
          </div>
        </div>
      </div>
    }
  </div>
}
@if (!live.Any()) { <div class="text-center text-muted py-5">لم يضف المركز خدمات بعد</div> }

@model Service
@{
  ViewData["Title"] = "اختيار الأخصائي";
  var emps = (List<AppUser>)ViewBag.Employees;
}
<a asp-action="Index" asp-route-id="@Model.SubscriberId" class="text-decoration-none">&rarr; @Model.Subscriber!.BusinessName</a>
<div class="card stat p-3 my-3">
  <div class="d-flex gap-3 align-items-center">
    <div style="width:90px">@Html.Thumb(Model.ImageUrl)</div>
    <div>
      <span class="badge bg-secondary">@Model.KindLabel</span>
      <div class="fw-bold">@Model.Name</div>
      <div class="small text-muted"><i class="bi bi-clock"></i> @Model.DurationMinutes دقيقة · <span class="price">@Model.Price.ToString("0.##") ر.س</span></div>
    </div>
  </div>
</div>

<h5 class="text-brand fw-bold mb-3">اختر الأخصائي</h5>
<div class="row g-3">
@foreach (var e in emps)
{
  <div class="col-6 col-md-4 col-lg-3">
    <a asp-controller="Booking" asp-action="Schedule" asp-route-serviceId="@Model.Id" asp-route-employeeId="@e.Id" class="text-decoration-none text-reset">
      <div class="card emp-card p-3 h-100 align-items-center">
        @Html.Thumb(e.PhotoUrl, "thumb-lg")
        <div class="fw-bold mt-2">@e.FullName</div>
        <div class="small text-muted">@e.Title</div>
        <span class="btn btn-sm btn-outline-primary mt-2">اختيار</span>
      </div>
    </a>
  </div>
}
</div>
@if (!emps.Any()) { <div class="text-center text-muted py-4">لا يوجد أخصائيون متاحون حاليًا لهذا المركز</div> }
@if (User.Identity?.IsAuthenticated != true)
{
  <div class="alert alert-info mt-4 small"><i class="bi bi-info-circle"></i> ستحتاج إلى تسجيل الدخول أو إنشاء حساب لاستكمال اختيار اليوم والوقت.</div>
}

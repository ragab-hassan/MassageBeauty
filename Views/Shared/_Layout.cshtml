<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>@ViewData["Title"] - منصات المساج والجمال</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.rtl.min.css" rel="stylesheet" />
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
  <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
  <nav class="navbar navbar-expand-lg app-nav">
    <div class="container">
      <a class="navbar-brand fw-bold" asp-area="" asp-controller="Home" asp-action="Index"><i class="bi bi-flower1"></i> منصات المساج والجمال</a>
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#nav"><span class="navbar-toggler-icon"></span></button>
      <div class="collapse navbar-collapse" id="nav">
        <ul class="navbar-nav me-auto">
          @if (User.IsInRole("Owner"))
          {
            <li class="nav-item"><a class="nav-link" asp-area="Owner" asp-controller="Dashboard" asp-action="Index"><i class="bi bi-grid"></i> لوحة التحكم</a></li>
            <li class="nav-item"><a class="nav-link" asp-area="Owner" asp-controller="Dashboard" asp-action="Create"><i class="bi bi-person-plus"></i> مشترك جديد</a></li>
            <li class="nav-item"><a class="nav-link" asp-area="Owner" asp-controller="Plans" asp-action="Index"><i class="bi bi-tags"></i> تصميم عروض وباقات</a></li>
          }
          @if (User.IsInRole("Subscriber"))
          {
            <li class="nav-item"><a class="nav-link" asp-area="Subscriber" asp-controller="Bookings" asp-action="Index"><i class="bi bi-calendar-check"></i> الحجوزات</a></li>
            <li class="nav-item"><a class="nav-link" asp-area="Subscriber" asp-controller="Services" asp-action="Index"><i class="bi bi-stars"></i> الخدمات</a></li>
            <li class="nav-item"><a class="nav-link" asp-area="Subscriber" asp-controller="Employees" asp-action="Index"><i class="bi bi-people"></i> العاملون</a></li>
            <li class="nav-item"><a class="nav-link" asp-area="Subscriber" asp-controller="Profile" asp-action="Index"><i class="bi bi-shop"></i> بيانات المركز</a></li>
          }
          @if (User.IsInRole("Employee"))
          {
            <li class="nav-item"><a class="nav-link" asp-area="Employee" asp-controller="Home" asp-action="Index"><i class="bi bi-calendar-check"></i> مواعيدي</a></li>
          }
          @if (User.IsInRole("Customer"))
          {
            <li class="nav-item"><a class="nav-link" asp-area="" asp-controller="Booking" asp-action="Mine"><i class="bi bi-calendar-heart"></i> حجوزاتي</a></li>
          }
        </ul>
        @if (User.Identity?.IsAuthenticated == true)
        {
          <form asp-area="" asp-controller="Account" asp-action="Logout" method="post" class="d-flex align-items-center gap-2">
            <span class="text-white-50 small">@User.Identity!.Name</span>
            <button class="btn btn-sm btn-outline-light"><i class="bi bi-box-arrow-left"></i> خروج</button>
          </form>
        }
        else
        {
          <div class="d-flex gap-2">
            <a class="btn btn-sm btn-outline-light" asp-area="" asp-controller="Account" asp-action="Login">تسجيل الدخول</a>
            <a class="btn btn-sm btn-light" asp-area="" asp-controller="Account" asp-action="Register">حساب جديد</a>
          </div>
        }
      </div>
    </div>
  </nav>

  <main class="container py-4">
    @if (TempData["Ok"] != null) { <div class="alert alert-success">@TempData["Ok"]</div> }
    @if (TempData["Err"] != null) { <div class="alert alert-danger">@TempData["Err"]</div> }
    @RenderBody()
  </main>
  <footer class="text-center text-muted small py-4">منصات المساج والجمال · المملكة العربية السعودية</footer>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

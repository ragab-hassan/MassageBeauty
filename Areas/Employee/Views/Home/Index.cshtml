@model List<Booking>
@{ ViewData["Title"] = "مواعيدي"; }
<h4 class="text-brand fw-bold mb-3">مواعيدي القادمة</h4>
<div class="card stat">
  <div class="table-responsive">
    <table class="table align-middle mb-0">
      <thead><tr><th>التاريخ</th><th>الوقت</th><th>الخدمة</th><th>العميل</th><th>الحالة</th><th>الكود</th></tr></thead>
      <tbody>
      @foreach (var b in Model)
      {
        <tr>
          <td>@b.Date.ToString("yyyy-MM-dd")</td>
          <td>@b.StartTime.ToString(@"hh\:mm") - @b.EndTime.ToString(@"hh\:mm")</td>
          <td>@b.Service.Name</td><td>@b.Customer.FullName</td>
          <td><span class="badge @(b.Status == BookingStatus.Confirmed ? "bg-success" : "bg-warning text-dark")">@b.StatusLabel</span></td>
          <td dir="ltr">@b.Code</td>
        </tr>
      }
      @if (!Model.Any()) { <tr><td colspan="6" class="text-center text-muted py-4">لا توجد مواعيد قادمة</td></tr> }
      </tbody>
    </table>
  </div>
</div>

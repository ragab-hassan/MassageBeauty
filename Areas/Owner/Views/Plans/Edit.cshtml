@model Plan
@{ ViewData["Title"] = Model.Id == 0 ? "باقة جديدة" : "تعديل باقة"; }
<h4 class="text-brand fw-bold mb-3">@ViewData["Title"]</h4>
<form asp-action="Edit" method="post" class="card stat p-4">
  <input type="hidden" asp-for="Id" />
  <div class="row g-3">
    <div class="col-md-6"><label class="form-label">اسم الباقة / العرض</label><input asp-for="Name" class="form-control" /><span asp-validation-for="Name" class="text-danger small"></span></div>
    <div class="col-md-3"><label class="form-label">المدة (بالأيام)</label><input asp-for="DurationDays" type="number" class="form-control" /><span asp-validation-for="DurationDays" class="text-danger small"></span></div>
    <div class="col-md-3"><label class="form-label">السعر (ر.س)</label><input asp-for="Price" type="number" step="0.01" class="form-control" /></div>
    <div class="col-md-3"><label class="form-label">نسبة الخصم %</label><input asp-for="DiscountPercent" type="number" step="0.01" class="form-control" /></div>
    <div class="col-md-3"><label class="form-label">بداية العرض</label><input asp-for="OfferStart" type="date" class="form-control" /></div>
    <div class="col-md-3"><label class="form-label">نهاية العرض</label><input asp-for="OfferEnd" type="date" class="form-control" /><span asp-validation-for="OfferEnd" class="text-danger small"></span></div>
    <div class="col-md-3"><label class="form-label">أقصى عدد عاملين</label><input asp-for="MaxEmployees" type="number" class="form-control" placeholder="فارغ = غير محدود" /></div>
    <div class="col-12"><label class="form-label">المميزات</label><textarea asp-for="Features" rows="3" class="form-control"></textarea></div>
    <div class="col-12 form-check ms-3"><input asp-for="IsActive" class="form-check-input" /><label asp-for="IsActive" class="form-check-label">الباقة مفعّلة</label></div>
  </div>
  <div class="mt-3"><button class="btn btn-brand px-4">حفظ</button> <a asp-action="Index" class="btn btn-light">إلغاء</a></div>
</form>

@model List<Plan>
@{ ViewData["Title"] = "تصميم عروض وباقات"; }
<div class="d-flex justify-content-between align-items-center mb-3">
  <h4 class="text-brand fw-bold mb-0">تصميم عروض وباقات</h4>
  <a asp-action="Edit" class="btn btn-brand"><i class="bi bi-plus-lg"></i> باقة / عرض جديد</a>
</div>
<div class="row g-3">
@foreach (var p in Model)
{
  <div class="col-md-6 col-lg-4">
    <div class="card plan-card h-100 @(p.IsActive ? "" : "off")">
      <div class="card-body">
        <div class="d-flex justify-content-between">
          <h5 class="fw-bold">@p.Name</h5>
          @if (p.OfferRunning) { <span class="badge bg-danger">عرض -@p.DiscountPercent.Value.ToString("0.##")%</span> }
          @if (!p.IsActive) { <span class="badge bg-secondary">موقوفة</span> }
        </div>
        <div class="my-2">
          @if (p.OfferRunning) { <span class="old-price me-2">@p.Price.ToString("N2")</span> }
          <span class="fs-3 fw-bold text-brand">@p.EffectivePrice.ToString("N2")</span> <span class="text-muted">ر.س / @p.DurationDays يوم</span>
        </div>
        <div class="small text-muted mb-1">الحد الأقصى للعاملين: @(p.MaxEmployees?.ToString() ?? "غير محدود")</div>
        @if (p.DiscountPercent is > 0 && (p.OfferStart != null || p.OfferEnd != null))
        {
          <div class="small text-muted mb-1">مدة العرض: @(p.OfferStart?.ToString("yyyy-MM-dd") ?? "-") → @(p.OfferEnd?.ToString("yyyy-MM-dd") ?? "-")</div>
        }
        @if (!string.IsNullOrWhiteSpace(p.Features)) { <p class="small mb-0">@p.Features</p> }
      </div>
      <div class="card-footer bg-transparent border-0 d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@p.Id" class="btn btn-sm btn-outline-primary">تعديل</a>
        <form asp-action="Toggle" asp-route-id="@p.Id" method="post"><button class="btn btn-sm btn-outline-secondary">@(p.IsActive ? "إيقاف" : "تفعيل")</button></form>
        <form asp-action="Delete" asp-route-id="@p.Id" method="post" onsubmit="return confirm('حذف الباقة؟')"><button class="btn btn-sm btn-outline-danger">حذف</button></form>
      </div>
    </div>
  </div>
}
</div>

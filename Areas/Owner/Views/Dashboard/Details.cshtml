@model Subscriber
@{
  ViewData["Title"] = Model.BusinessName;
  var plans = (List<Plan>)ViewBag.Plans;
  var cur = Model.Current;
  var wa = new string((Model.Phone ?? "").Where(char.IsDigit).ToArray());
}
<div class="mb-3"><a asp-action="Index" class="text-decoration-none">&rarr; رجوع للوحة التحكم</a></div>
<div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
  <h4 class="text-brand fw-bold mb-0">@Model.BusinessName
    @if (!Model.IsActive) { <span class="badge bg-danger">موقوف</span> }
  </h4>
  <div class="d-flex gap-2">
    <form asp-action="ToggleRenewal" asp-route-id="@Model.Id" method="post">
      <button class="btn @(Model.AllowRenewal ? "btn-outline-secondary" : "btn-success")">
        <i class="bi bi-arrow-repeat"></i> @(Model.AllowRenewal ? "إيقاف التجديد" : "السماح بالتجديد")
      </button>
    </form>
    <form asp-action="ToggleActive" asp-route-id="@Model.Id" method="post" onsubmit="return confirm('تأكيد العملية؟')">
      <button class="btn @(Model.IsActive ? "btn-outline-danger" : "btn-success")">
        <i class="bi bi-power"></i> @(Model.IsActive ? "إيقاف الحساب" : "تفعيل الحساب")
      </button>
    </form>
  </div>
</div>

<div class="row g-3">
  <div class="col-lg-6">
    <div class="card stat p-3 h-100">
      <h6 class="text-brand fw-bold">بيانات المشترك</h6>
      <form asp-action="SaveNotes" asp-route-id="@Model.Id" method="post">
        <table class="table table-sm mb-2">
          <tr><th style="width:35%">المسؤول</th><td>@Model.OwnerName</td></tr>
          <tr><th>تاريخ التسجيل</th><td>@Model.CreatedAt.ToString("yyyy-MM-dd")</td></tr>
          <tr><th>عدد العاملين</th><td>@Model.EmployeesCount</td></tr>
          <tr><th>رقم الهاتف</th><td><input name="phone" class="form-control form-control-sm" value="@Model.Phone" /></td></tr>
          <tr><th>المدينة</th><td><input name="city" class="form-control form-control-sm" value="@Model.City" /></td></tr>
          <tr><th>العنوان</th><td><input name="address" class="form-control form-control-sm" value="@Model.Address" /></td></tr>
          <tr><th>ملاحظات</th><td><textarea name="notes" rows="2" class="form-control form-control-sm">@Model.Notes</textarea></td></tr>
        </table>
        <button class="btn btn-sm btn-brand">حفظ</button>
        @if (wa.Length > 0)
        {
          <a class="btn btn-sm btn-success" target="_blank" href="https://wa.me/@wa"><i class="bi bi-whatsapp"></i> واتساب</a>
        }
      </form>
    </div>
  </div>

  <div class="col-lg-6">
    <div class="card stat p-3 h-100">
      <h6 class="text-brand fw-bold">تجديد الاشتراك</h6>
      @if (!Model.AllowRenewal) { <div class="alert alert-secondary py-2 small">التجديد موقوف لهذا الحساب. اضغط "السماح بالتجديد" أولًا.</div> }
      <form asp-action="Renew" asp-route-id="@Model.Id" method="post">
        <div class="mb-2">
          <label class="form-label small">الباقة</label>
          <select name="planId" id="planId" class="form-select" @(Model.AllowRenewal ? "" : "disabled")>
            @foreach (var p in plans)
            {
              <option value="@p.Id" data-price="@p.EffectivePrice.ToString(System.Globalization.CultureInfo.InvariantCulture)">@p.Name - @p.DurationDays يوم - @p.EffectivePrice.ToString("N2") ر.س</option>
            }
          </select>
        </div>
        <div class="mb-3">
          <label class="form-label small">المبلغ المدفوع (ر.س)</label>
          <input name="pricePaid" id="pricePaid" type="number" step="0.01" min="0" class="form-control" @(Model.AllowRenewal ? "" : "disabled") />
        </div>
        <button class="btn btn-brand" @(Model.AllowRenewal ? "" : "disabled")>تجديد</button>
        <div class="form-text">يبدأ التجديد من تاريخ نهاية الاشتراك الحالي إن كان ساريًا.</div>
      </form>
    </div>
  </div>
</div>

<div class="card stat p-3 mt-3">
  <h6 class="text-brand fw-bold">سجل الاشتراكات</h6>
  <div class="table-responsive">
    <table class="table table-sm align-middle mb-0">
      <thead><tr><th>الباقة</th><th>البداية</th><th>النهاية</th><th>الفترة</th><th>السعر</th></tr></thead>
      <tbody>
      @foreach (var x in Model.Subscriptions.OrderByDescending(x => x.StartDate))
      {
        <tr>
          <td>@x.Plan.Name</td><td>@x.StartDate.ToString("yyyy-MM-dd")</td><td>@x.EndDate.ToString("yyyy-MM-dd")</td>
          <td>@x.PeriodDays يوم</td><td>@x.PricePaid.ToString("N2") ر.س</td>
        </tr>
      }
      </tbody>
    </table>
  </div>
</div>

@section Scripts {
<script>
  const sel = document.getElementById('planId'), price = document.getElementById('pricePaid');
  function sync(){ if(sel && price) price.value = sel.options[sel.selectedIndex].dataset.price; }
  sel?.addEventListener('change', sync); sync();
</script>
}

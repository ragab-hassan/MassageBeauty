@model Service
@{ ViewData["Title"] = Model.Id == 0 ? "إضافة" : "تعديل"; }
<h4 class="text-brand fw-bold mb-3">@(Model.Id == 0 ? "إضافة خدمة / باقة / عرض" : "تعديل")</h4>
<form asp-action="Edit" method="post" enctype="multipart/form-data" class="card stat p-4">
  <div asp-validation-summary="All" class="text-danger"></div>
  <input type="hidden" asp-for="Id" />
  <div class="row g-3">
    <div class="col-md-5"><label class="form-label">الاسم</label><input asp-for="Name" class="form-control" /></div>
    <div class="col-md-3">
      <label class="form-label">النوع</label>
      <select name="Kind" class="form-select">
        <option value="0" selected="@(Model.Kind == ServiceKind.Service)">خدمة</option>
        <option value="1" selected="@(Model.Kind == ServiceKind.Package)">باقة</option>
        <option value="2" selected="@(Model.Kind == ServiceKind.Offer)">عرض</option>
      </select>
    </div>
    <div class="col-md-2"><label class="form-label">المدة (دقيقة)</label><input asp-for="DurationMinutes" type="number" class="form-control" /></div>
    <div class="col-md-2"><label class="form-label">الترتيب</label><input asp-for="SortOrder" type="number" class="form-control" /></div>
    <div class="col-md-3"><label class="form-label">السعر (ر.س)</label><input asp-for="Price" type="number" step="0.01" class="form-control" /></div>
    <div class="col-md-3"><label class="form-label">السعر قبل الخصم (اختياري)</label><input asp-for="OldPrice" type="number" step="0.01" class="form-control" /></div>
    <div class="col-md-3"><label class="form-label">نهاية العرض (للعروض)</label><input asp-for="OfferEnd" type="date" class="form-control" /></div>
    <div class="col-md-3 d-flex align-items-end"><div class="form-check"><input asp-for="IsActive" class="form-check-input" /><label asp-for="IsActive" class="form-check-label">ظاهرة للعملاء</label></div></div>
    <div class="col-12"><label class="form-label">فوائد للجسم (سطر قصير)</label><input asp-for="Benefits" class="form-control" placeholder="مثال: تخفيف شد العضلات وتحسين الدورة الدموية" /></div>
    <div class="col-12"><label class="form-label">تفاصيل</label><textarea asp-for="Description" rows="3" class="form-control"></textarea></div>
    <div class="col-md-6">
      <label class="form-label">الصورة (JPG/PNG/WEBP حتى 3 ميجا)</label>
      <input type="file" name="image" accept="image/jpeg,image/png,image/webp" class="form-control" />
      @if (!string.IsNullOrEmpty(Model.ImageUrl))
      {
        <div class="mt-2 d-flex align-items-center gap-3"><div style="width:120px">@Html.Thumb(Model.ImageUrl)</div>
          <div class="form-check"><input type="checkbox" name="removeImage" value="true" class="form-check-input" id="rm" /><label for="rm" class="form-check-label">حذف الصورة</label></div></div>
      }
    </div>
  </div>
  <div class="mt-3"><button class="btn btn-brand px-4">حفظ</button> <a asp-action="Index" class="btn btn-light">إلغاء</a></div>
</form>

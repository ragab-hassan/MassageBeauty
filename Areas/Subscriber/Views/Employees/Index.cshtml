@model List<AppUser>
@{
  ViewData["Title"] = "العاملون";
  var biz = (Subscriber)ViewBag.Business;
  var cur = biz.Current;
  var max = cur?.Plan.MaxEmployees;
}
<div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
  <div>
    <h4 class="text-brand fw-bold mb-0">عاملو @biz.BusinessName</h4>
    <div class="small text-muted">
      @if (cur != null) { <span>الاشتراك ينتهي في @cur.EndDate.ToString("yyyy-MM-dd") (@(cur.DaysLeft >= 0 ? $"متبقي {cur.DaysLeft} يوم" : "منتهي"))</span> }
      · العاملون: @Model.Count@(max != null ? $" / {max}" : "")
    </div>
  </div>
  <button class="btn btn-brand" data-bs-toggle="modal" data-bs-target="#empModal" onclick="openEmp(null)"><i class="bi bi-person-plus"></i> إضافة عامل</button>
</div>

<div class="card stat">
  <div class="table-responsive">
    <table class="table align-middle mb-0">
      <thead><tr><th>الاسم</th><th>اسم المستخدم</th><th>الهاتف</th><th>الحالة</th><th></th></tr></thead>
      <tbody>
      @foreach (var e in Model)
      {
        <tr>
          <td>@e.FullName</td>
          <td dir="ltr" class="text-end">@e.UserName</td>
          <td>@e.PhoneNumber</td>
          <td><span class="badge @(e.IsActive ? "bg-success" : "bg-secondary")">@(e.IsActive ? "نشط" : "موقوف")</span></td>
          <td class="text-nowrap">
            <button class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#empModal"
                    data-id="@e.Id" data-name="@e.FullName" data-user="@e.UserName" data-phone="@e.PhoneNumber" onclick="openEmp(this)">تعديل</button>
            <form asp-action="ToggleActive" asp-route-id="@e.Id" method="post" class="d-inline"><button class="btn btn-sm btn-outline-secondary">@(e.IsActive ? "إيقاف" : "تفعيل")</button></form>
            <form asp-action="Delete" asp-route-id="@e.Id" method="post" class="d-inline" onsubmit="return confirm('حذف العامل نهائيًا؟')"><button class="btn btn-sm btn-outline-danger">حذف</button></form>
          </td>
        </tr>
      }
      @if (!Model.Any()) { <tr><td colspan="5" class="text-center text-muted py-4">لا يوجد عاملون بعد</td></tr> }
      </tbody>
    </table>
  </div>
</div>

<div class="modal fade" id="empModal" tabindex="-1">
  <div class="modal-dialog">
    <form asp-action="Save" method="post" class="modal-content">
      <div class="modal-header"><h5 class="modal-title" id="empTitle">عامل</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
      <div class="modal-body">
        <input type="hidden" name="id" id="empId" />
        <div class="mb-3"><label class="form-label">الاسم</label><input name="fullName" id="empName" class="form-control" required /></div>
        <div class="mb-3"><label class="form-label">اسم المستخدم</label><input name="userName" id="empUser" class="form-control" dir="ltr" required /></div>
        <div class="mb-3"><label class="form-label">رقم الهاتف</label><input name="phone" id="empPhone" class="form-control" /></div>
        <div class="mb-1"><label class="form-label">كلمة المرور</label><input name="newPassword" id="empPass" class="form-control" dir="ltr" autocomplete="new-password" /></div>
        <div class="form-text" id="passHint"></div>
      </div>
      <div class="modal-footer"><button class="btn btn-brand">حفظ</button><button type="button" class="btn btn-light" data-bs-dismiss="modal">إلغاء</button></div>
    </form>
  </div>
</div>

@section Scripts {
<script>
  function openEmp(btn){
    const isNew = !btn;
    document.getElementById('empTitle').textContent = isNew ? 'إضافة عامل' : 'تعديل بيانات العامل';
    document.getElementById('empId').value = isNew ? '' : btn.dataset.id;
    document.getElementById('empName').value = isNew ? '' : btn.dataset.name;
    document.getElementById('empUser').value = isNew ? '' : btn.dataset.user;
    document.getElementById('empPhone').value = isNew ? '' : (btn.dataset.phone || '');
    document.getElementById('empPass').value = '';
    document.getElementById('empPass').required = isNew;
    document.getElementById('passHint').textContent = isNew ? '' : 'اتركها فارغة إن لم ترغب في تغيير كلمة المرور (كلمات المرور مشفّرة ولا يمكن عرضها)';
  }
</script>
}
